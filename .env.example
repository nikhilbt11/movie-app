# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/moviesite?retryWrites=true&w=majority

# Password you type on the admin login page
ADMIN_PASSWORD=change-this-password

# Long random string used to sign login tokens (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string

# Get these from Cloudflare dashboard -> R2 -> Account API Tokens
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key

# The name of your R2 bucket
CLOUDFLARE_BUCKET_NAME=my-movies

# Your R2 public URL (e.g., https://pub-xxxxx.r2.dev or your custom domain)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
